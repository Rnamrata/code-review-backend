# Server Configuration
# Use "development" locally. Deployments must set "production".
NODE_ENV=development
PORT=4000
HOST=localhost

# Ruff (Python analysis)
RUFF_BIN=ruff
RUFF_TIMEOUT_MS=15000

# Input limits
MAX_FILE_SIZE_MB=1
ALLOWED_EXTENSIONS=.py,.js,.java,.ts,.jsx,.tsx

# Complexity Thresholds
CYCLOMATIC_COMPLEXITY_THRESHOLD=5
COGNITIVE_COMPLEXITY_THRESHOLD=7
MAX_NESTING_DEPTH=2

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100

# LLM analyzer (Ollama). Off by default; linters work without it.
# Needs `ollama serve` running and the model pulled: ollama pull qwen2.5-coder:7b
LLM_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5-coder:7b
LLM_TEMPERATURE=0
LLM_SEED=42
# Must stay below the chatbot's 60 s limit.
LLM_TIMEOUT_MS=40000
# Context window sent with each request; Ollama's own default is only 4096.
LLM_NUM_CTX=8192
# How long Ollama keeps the model loaded after a review (avoids a ~15 s reload).
LLM_KEEP_ALIVE=30m
# Larger files skip the LLM (with a warning) instead of being silently truncated.
LLM_MAX_CODE_CHARS=12000
LLM_MAX_FINDINGS=20