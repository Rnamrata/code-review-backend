# Server Configuration
NODE_ENV=development
PORT=4000
HOST=localhost

# Ruff (Python analysis)
RUFF_BIN=ruff
RUFF_TIMEOUT_MS=15000

# Input limits
MAX_FILE_SIZE_MB=1
ALLOWED_EXTENSIONS=.py,.js,.java,.ts,.jsx,.tsx

# Analysis Configuration
ENABLE_STATIC_ANALYSIS=true
ENABLE_SECURITY_ANALYSIS=true
ENABLE_COMPLEXITY_ANALYSIS=true
ENABLE_STYLE_CHECKING=true
ENABLE_RAG_ANALYSIS=true

# Complexity Thresholds
CYCLOMATIC_COMPLEXITY_THRESHOLD=5
COGNITIVE_COMPLEXITY_THRESHOLD=7
MAX_NESTING_DEPTH=2

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_TO_CONSOLE=true

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=100